{
  "name": "fyflow-plugin-anidb",
  "version": "0.0.0",
  "private": true,
  "description": "A fyflow-app Plugin for AniDB's UDP API, built on anidb-udp-client",
  "keywords": [
    "fyflow",
    "fyflow-plugin",
    "anidb"
  ],
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "peerDependencies": {
    "fyflow-plugin-sdk": "^0.5.0"
  },
  "dependencies": {
    "anidb-udp-client": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fyflow-orchestration": "0.13.0",
    "fyflow-plugin-sdk": "0.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
