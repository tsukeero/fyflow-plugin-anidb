{
  "name": "fyflow-plugin-anidb",
  "version": "0.1.0",
  "private": true,
  "description": "A fyflow-app Plugin for AniDB's UDP API, built on anidb-udp-client",
  "keywords": [
    "fyflow",
    "fyflow-plugin",
    "anidb"
  ],
  "homepage": "https://github.com/tsukeero/fyflow-plugin-anidb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukeero/fyflow-plugin-anidb.git"
  },
  "bugs": "https://github.com/tsukeero/fyflow-plugin-anidb/issues",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./dist/anidb/plugin.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/plugin-folder.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:deno": "deno run -A node_modules/vitest/vitest.mjs run",
    "check:dist": "npm run build && node scripts/check-dist.ts",
    "smoke": "node scripts/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:deno && npm run check:dist"
  },
  "peerDependencies": {
    "fyflow-plugin-sdk": "^0.11.0"
  },
  "dependencies": {
    "anidb-udp-client": "^2.0.2",
    "hash-wasm": "^4.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fyflow-orchestration": "0.14.0",
    "fyflow-plugin-sdk": "0.11.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "fyflow": {
    "name": "AniDB",
    "icon": "database",
    "build": "npm run build",
    "pack": "dist/anidb"
  }
}
